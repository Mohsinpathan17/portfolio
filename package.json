{
  "name": "mohsin-pathans-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "start": "vite --host 0.0.0.0",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test:ui": "playwright test",
    "check:visual": "node --use-env-proxy scripts/visual-check.mjs",
    "resume": "node scripts/generate-resume.mjs",
    "test:logic": "node --test tests/*.test.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.1",
    "lucide-react": "^1.52.0",
    "react": "^19.2.8",
